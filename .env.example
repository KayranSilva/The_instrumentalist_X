# Copie este arquivo para ".env" (nunca comitado) e preencha com os valores
# reais do seu projeto Supabase. Settings → API no painel do Supabase.

# URL do projeto, ex: https://xxxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Chave anon/publishable — é pública por natureza (protegida pelo RLS),
# mas mesmo assim fica em variável de ambiente, nunca hardcoded no código.
SUPABASE_ANON_KEY=

# Opcional: só use se quiser trocar a porta padrão do backend (8001).
# PORT=8001
